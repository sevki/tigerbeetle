{
  "name": "tigerbeetle",
  "main": "src/index.mjs",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "TigerBeetleLedger" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TigerBeetleLedger"] }],
  // The DT Bank UI (../wasm-worker-frontend), built and copied into ./public (celld requires
  // the assets directory to live inside the project; see that package's README for the copy
  // step), and served by this same Worker/origin. `run_worker_first: true` routes every request
  // through src/index.mjs first, which implements the /ledger/* API vs.
  // static-asset-with-SPA-fallback split itself (see there) rather than relying on
  // `not_found_handling`, which celld doesn't implement the same way wrangler/real Cloudflare do.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
