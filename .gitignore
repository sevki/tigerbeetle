src/clients/c/lib
/tigerbeetle
/tigerbeetle.exe
*_*.tigerbeetle.*
*_*.tigerbeetle
.zig-cache/
zig-cache/
zig-out/

tools/
# By convention, logs from simulator use .vopr extension.
*.vopr

# Death to .DS_Store
.DS_Store

# wasm-worker: npm/celld/wrangler local artifacts
src/clients/wasm-worker/node_modules/
src/clients/wasm-worker/.celld/
src/clients/wasm-worker/.celld-test-state/
src/clients/wasm-worker/.celld-openapi-test-state/
src/clients/wasm-worker/.celld-e2e-state/
src/clients/wasm-worker/.wrangler/
# Generated by `npm run generate:client` (openapi-typescript) from openapi.yaml.
src/clients/wasm-worker/src/openapi.d.ts
# `npm run build`'s copy of wasm-worker-frontend/dist -- see [assets] in wrangler.toml/.jsonc.
# celld requires the assets directory to live inside the project, so this can't just reference
# ../wasm-worker-frontend/dist directly.
src/clients/wasm-worker/public/

# wasm-worker-frontend: kept as a *sibling* of wasm-worker (not nested inside it) specifically so
# celld's/wrangler's file watchers never see its node_modules/dist churn — that was observed to
# put celld dev into a continuous "change detected; rebuilding" restart loop.
src/clients/wasm-worker-frontend/node_modules/
src/clients/wasm-worker-frontend/dist/
src/clients/wasm-worker-frontend/*.tsbuildinfo
# Generated by `pnpm generate:client` (openapi-typescript) from ../wasm-worker/openapi.yaml.
src/clients/wasm-worker-frontend/src/openapi.d.ts
src/clients/wasm-worker-frontend/test-results/
src/clients/wasm-worker-frontend/playwright-report/
